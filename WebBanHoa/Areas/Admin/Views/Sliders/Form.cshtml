@model Slider
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm slide" : "Sửa slide"; }
<div class="page-head"><div><h2>@ViewData["Title"]</h2><p><a href="/Admin/Sliders">← Slide trang chủ</a></p></div></div>
<form method="post" action="/Admin/Sliders/Save" enctype="multipart/form-data" class="form-grid">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="panel">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field"><label asp-for="Title"></label><input class="input" asp-for="Title" /><span asp-validation-for="Title"></span><div class="hint">2 từ cuối của tiêu đề sẽ được in nghiêng màu hồng.</div></div>
        <div class="field"><label asp-for="Subtitle"></label><textarea class="input" asp-for="Subtitle" rows="2"></textarea></div>
        <div class="row-2">
            <div class="field"><label asp-for="Link"></label><input class="input" asp-for="Link" placeholder="/cua-hang" /></div>
            <div class="field"><label asp-for="SortOrder"></label><input class="input" asp-for="SortOrder" type="number" /></div>
        </div>
        <label class="switch"><input type="checkbox" asp-for="IsActive" /> Hiển thị</label>
    </div>
    <div class="panel">
        <partial name="_ImageField" model="Model.Image" />
        <div class="hint" style="margin-bottom:12px">Nên dùng ảnh PNG/SVG nền trong suốt để đẹp nhất trên khung vòm.</div>
        <button class="btn btn-primary" style="width:100%;justify-content:center">Lưu slide</button>
    </div>
</form>
