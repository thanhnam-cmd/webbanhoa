@model PagedList<Customer>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="page-head"><div><h2>Khách hàng</h2><p>Tài khoản thành viên đã đăng ký trên website.</p></div></div>
<div class="panel">
    <div class="panel-head"><form class="search"><svg class="icon"><use href="#i-search" /></svg><input class="input" name="q" value="@Model.Q" placeholder="Tên, email, số điện thoại…" /></form></div>
    <div class="table-wrap">
        <table class="tbl">
            <thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Ngày đăng ký</th><th class="r">Số đơn</th><th class="r">Tổng chi tiêu</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @if (!Model.Items.Any()) { <tr><td colspan="7" class="empty">Chưa có khách hàng</td></tr> }
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td><div style="display:flex;gap:10px;align-items:center"><span class="avatar" style="width:34px;height:34px;font-size:13px">@c.FullName[..1]</span><div class="name">@c.FullName</div></div></td>
                        <td>@c.Email<div class="sub">@c.Phone</div></td>
                        <td>@c.CreatedAt.ToLocal()</td>
                        <td class="r">@c.Orders.Count</td>
                        <td class="r"><b>@c.Orders.Where(o => o.Status != OrderStatus.DaHuy).Sum(o => o.Total).ToVnd()</b></td>
                        <td><span class="pill @(c.IsLocked ? "st-danger" : "st-ok")">@(c.IsLocked ? "Đã khóa" : "Hoạt động")</span></td>
                        <td><div class="actions">
                            <a href="/Admin/Orders?q=@Uri.EscapeDataString(c.Phone ?? c.FullName)" class="btn btn-ghost btn-sm">Đơn hàng</a>
                            <form method="post" action="/Admin/Customers/ToggleLock/@c.Id" data-confirm="@(c.IsLocked ? "Mở khóa" : "Khóa") tài khoản @c.Email?">@Html.AntiForgeryToken()<button class="btn btn-sm @(c.IsLocked ? "btn-ok" : "btn-danger")">@(c.IsLocked ? "Mở khóa" : "Khóa")</button></form>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total, Helpers.QueryQ(Model.Q))" />
</div>
