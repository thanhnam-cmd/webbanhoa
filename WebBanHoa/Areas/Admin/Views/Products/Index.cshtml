@model PagedList<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    int? catId = ViewBag.CategoryId;
    var baseQuery = string.Join("&", new[] { string.IsNullOrEmpty(Model.Q) ? null : "q=" + Uri.EscapeDataString(Model.Q), catId.HasValue ? "categoryId=" + catId : null }.Where(x => x != null));
}
<div class="page-head">
    <div><h2>Sản phẩm</h2><p>Quản lý toàn bộ mẫu hoa đang kinh doanh.</p></div>
    <a href="/Admin/Products/Create" class="btn btn-rose"><svg class="icon"><use href="#i-plus" /></svg> Thêm sản phẩm</a>
</div>
<div class="panel">
    <form class="panel-head">
        <div class="toolbar">
            <div class="search"><svg class="icon"><use href="#i-search" /></svg><input class="input" name="q" value="@Model.Q" placeholder="Tìm theo tên, mã SP…" /></div>
            <select class="input" name="categoryId" asp-items="ViewBag.Categories" style="width:auto" onchange="this.form.submit()"><option value="">Tất cả danh mục</option></select>
        </div>
    </form>
    <div class="table-wrap">
        <table class="tbl">
            <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th class="r">Giá bán</th><th class="r">Tồn kho</th><th class="r">Đã bán</th><th>Hiển thị</th><th></th></tr></thead>
            <tbody>
                @if (!Model.Items.Any()) { <tr><td colspan="7" class="empty">Không có sản phẩm nào</td></tr> }
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><div style="display:flex;gap:12px;align-items:center"><img class="thumb" src="@p.Image.ImageOrDefault()" alt="" /><div><div class="name">@p.Name @if (p.IsFeatured) { <span class="pill st-violet" style="margin-left:4px">Nổi bật</span> }</div><div class="sub">@p.Sku · @p.Occasion?.Name</div></div></div></td>
                        <td>@p.Category?.Name</td>
                        <td class="r"><b>@p.FinalPrice.ToVnd()</b>@if (p.DiscountPercent > 0) { <div class="sub"><s>@p.Price.ToVnd()</s> -@p.DiscountPercent%</div> }</td>
                        <td class="r"><span class="pill @(p.Stock <= 0 ? "st-danger" : p.Stock < 20 ? "st-warn" : "st-ok")">@p.Stock</span></td>
                        <td class="r">@p.Sold</td>
                        <td><label class="switch" style="margin:0"><input type="checkbox" checked="@p.IsActive" data-toggle-url="/Admin/Products/Toggle/@p.Id" /></label></td>
                        <td><div class="actions">
                            <a href="/san-pham/@p.Slug" target="_blank" class="btn btn-ghost btn-sm icon-btn" title="Xem"><svg class="icon icon-sm"><use href="#i-arrow" /></svg></a>
                            <a href="/Admin/Products/Edit/@p.Id" class="btn btn-ghost btn-sm"><svg class="icon icon-sm"><use href="#i-pen" /></svg> Sửa</a>
                            <form method="post" action="/Admin/Products/Delete/@p.Id" data-confirm="Xóa sản phẩm “@p.Name”?">@Html.AntiForgeryToken()<button class="btn btn-danger btn-sm icon-btn" title="Xóa"><svg class="icon icon-sm"><use href="#i-trash" /></svg></button></form>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total, baseQuery)" />
</div>
