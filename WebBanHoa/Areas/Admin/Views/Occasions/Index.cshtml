@model PagedList<Occasion>
@{ ViewData["Title"] = "Dịp tặng"; }
<div class="page-head">
    <div><h2>Dịp tặng hoa</h2><p>Phân loại sản phẩm theo dịp: sinh nhật, tình yêu, khai trương…</p></div>
    <a href="/Admin/Occasions/Create" class="btn btn-rose"><svg class="icon"><use href="#i-plus" /></svg> Thêm dịp tặng</a>
</div>
<div class="panel">
    <div class="panel-head"><form class="search"><svg class="icon"><use href="#i-search" /></svg><input class="input" name="q" value="@Model.Q" placeholder="Tìm dịp tặng…" /></form></div>
    <div class="table-wrap">
        <table class="tbl">
            <thead><tr><th>#</th><th>Dịp tặng</th><th>Mô tả</th><th>Số SP</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td class="name">@o.Name<div class="sub">/@o.Slug</div></td>
                        <td class="sub">@o.Description</td>
                        <td>@o.Products.Count</td>
                        <td><span class="pill @(o.IsActive ? "st-ok" : "st-muted")">@(o.IsActive ? "Hiển thị" : "Ẩn")</span></td>
                        <td><div class="actions">
                            <a href="/Admin/Occasions/Edit/@o.Id" class="btn btn-ghost btn-sm"><svg class="icon icon-sm"><use href="#i-pen" /></svg> Sửa</a>
                            <form method="post" action="/Admin/Occasions/Delete/@o.Id" data-confirm="Xóa dịp tặng “@o.Name”? Các sản phẩm thuộc dịp này sẽ không còn gắn dịp.">@Html.AntiForgeryToken()<button class="btn btn-danger btn-sm icon-btn" title="Xóa"><svg class="icon icon-sm"><use href="#i-trash" /></svg></button></form>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total, Helpers.QueryQ(Model.Q))" />
</div>
