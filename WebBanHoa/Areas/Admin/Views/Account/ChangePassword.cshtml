@{ ViewData["Title"] = "Đổi mật khẩu"; }
<form method="post" class="panel" style="max-width:480px">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field"><label>Mật khẩu hiện tại</label><input class="input" type="password" name="currentPassword" required /></div>
    <div class="field"><label>Mật khẩu mới</label><input class="input" type="password" name="newPassword" minlength="6" required /></div>
    <div class="field"><label>Nhập lại mật khẩu mới</label><input class="input" type="password" name="confirmPassword" minlength="6" required /></div>
    <button class="btn btn-primary">Cập nhật mật khẩu</button>
</form>
