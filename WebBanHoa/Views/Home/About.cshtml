@{ ViewData["Title"] = "Giới thiệu"; }
<section class="section-sm">
    <div class="container about-hero">
        <div>
            <div class="crumbs"><a href="/">Trang chủ</a><span>Giới thiệu</span></div>
            <span class="eyebrow" style="margin-top:20px">Về Floria</span>
            <h1 class="section-title" data-split>Chúng tôi trao<br /><em>cảm xúc</em> qua hoa</h1>
            <p class="reveal" style="color:var(--ink-2)">Floria ra đời từ tình yêu với hoa và mong muốn giúp mọi người gửi gắm yêu thương dễ dàng hơn. Chỉ với vài thao tác, bạn có thể đặt một bó hoa tươi được cắm thủ công, kèm thiệp viết tay và giao tận tay người nhận trong 2 giờ.</p>
            <p class="reveal" style="color:var(--ink-2)">Chúng tôi làm việc trực tiếp với các nhà vườn tại Đà Lạt và nhà nhập khẩu uy tín để đảm bảo mỗi bông hoa đều tươi mới, rạng rỡ nhất.</p>
        </div>
        <div class="story-media">
            <div class="m1 reveal" data-reveal="mask"><img src="/img/flowers/p16.svg" alt="" /></div>
            <div class="m2 reveal" data-reveal="zoom" style="--d:.2s"><img src="/img/flowers/p04.svg" alt="" /></div>
        </div>
    </div>
</section>
<section class="section bg-paper">
    <div class="container stat-row" data-stagger="0.1">
        <div><b data-count="6" data-suffix="+">0</b>Năm kinh nghiệm</div>
        <div><b data-count="12000" data-suffix="+">0</b>Bó hoa đã giao</div>
        <div><b data-count="35">0</b>Florist & nhân viên</div>
        <div><b data-count="98" data-suffix="%">0</b>Khách hàng hài lòng</div>
    </div>
</section>
<section class="section">
    <div class="container">
        <div class="section-head"><div><span class="eyebrow">Giá trị cốt lõi</span><h2 class="section-title" data-split>Điều làm nên <em>Floria</em></h2></div></div>
        <div class="steps" data-stagger="0.1">
            <div class="step"><span class="fi"><svg class="icon"><use href="#i-leaf" /></svg></span><h3>Tươi mới</h3><p>Hoa nhập mỗi sáng, không dùng hoa tồn kho.</p></div>
            <div class="step"><span class="fi"><svg class="icon"><use href="#i-flower" /></svg></span><h3>Thủ công</h3><p>Mỗi thiết kế do florist cắm tay tỉ mỉ.</p></div>
            <div class="step"><span class="fi"><svg class="icon"><use href="#i-clock" /></svg></span><h3>Đúng hẹn</h3><p>Giao đúng ngày, đúng khung giờ bạn chọn.</p></div>
            <div class="step"><span class="fi"><svg class="icon"><use href="#i-shield" /></svg></span><h3>Tận tâm</h3><p>Đổi mới miễn phí nếu hoa không như cam kết.</p></div>
        </div>
    </div>
</section>
