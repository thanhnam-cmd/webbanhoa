@model CartView
@{
    ViewData["Title"] = "Giỏ hàng";
    var left = Math.Max(0, CartService.FreeShipThreshold - Model.Subtotal);
    var percent = (int)Math.Min(100, Model.Subtotal / CartService.FreeShipThreshold * 100);
}
<section class="page-hero">
    <div class="container">
        <div class="crumbs"><a href="/">Trang chủ</a><span>Giỏ hàng</span></div>
        <h1 data-split>Giỏ hàng của bạn</h1>
    </div>
</section>

<section class="container">
    @if (!Model.Lines.Any())
    {
        <div class="empty reveal">
            <img src="/img/flowers/p02.svg" alt="" style="border-radius:50%" />
            <h3>Giỏ hàng đang trống</h3>
            <p>Hãy chọn cho mình một bó hoa thật xinh nhé!</p>
            <a href="/cua-hang" class="btn btn-primary">Tiếp tục mua sắm <svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="card reveal">
                @foreach (var l in Model.Lines)
                {
                    <div class="cart-item" data-id="@l.Product.Id">
                        <a href="/san-pham/@l.Product.Slug"><img src="@l.Product.Image.ImageOrDefault()" alt="@l.Product.Name" /></a>
                        <div>
                            <h3><a href="/san-pham/@l.Product.Slug">@l.Product.Name</a></h3>
                            <div class="price" style="margin-bottom:10px"><b style="font-size:15px">@l.Product.FinalPrice.ToVnd()</b>@if (l.Product.DiscountPercent > 0) { <s>@l.Product.Price.ToVnd()</s> }</div>
                            <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
                                <div class="qty">
                                    <button type="button" data-step="-1" aria-label="Giảm"><svg class="icon icon-sm"><use href="#i-minus" /></svg></button>
                                    <input type="number" value="@l.Quantity" min="1" max="99" aria-label="Số lượng" />
                                    <button type="button" data-step="1" aria-label="Tăng"><svg class="icon icon-sm"><use href="#i-plus" /></svg></button>
                                </div>
                                <form method="post" action="/gio-hang/xoa">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@l.Product.Id" />
                                    <button class="remove-btn"><svg class="icon icon-sm"><use href="#i-trash" /></svg> Xóa</button>
                                </form>
                            </div>
                        </div>
                        <div class="line-total">@l.LineTotal.ToVnd()</div>
                    </div>
                }
                <a href="/cua-hang" class="link-arrow" style="margin-top:22px">← Tiếp tục mua sắm</a>
            </div>

            <aside class="card summary reveal" data-reveal="right">
                <h3 class="card-title">Tóm tắt đơn hàng</h3>
                <div class="freeship" id="freeShip">
                    @if (left > 0) { <span>Mua thêm <b>@left.ToVnd()</b> để được <b>miễn phí giao hàng</b> 🚚</span> }
                    else { <span>🎉 Đơn hàng của bạn được <b>miễn phí giao hàng</b>!<b hidden></b></span> }
                    <div class="bar"><i style="width:@percent%"></i></div>
                </div>
                <div class="summary-row"><span>Tạm tính</span><span id="sumSubtotal">@Model.Subtotal.ToVnd()</span></div>
                <div class="summary-row"><span>Phí giao hàng</span><span id="sumShipping">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToVnd())</span></div>
                <div class="summary-row total"><span>Tổng cộng</span><b id="sumTotal">@Model.Total.ToVnd()</b></div>
                <a href="/thanh-toan" class="btn btn-primary btn-block" style="margin-top:20px">Tiến hành thanh toán <svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
                <p style="font-size:13px;color:var(--muted);text-align:center;margin:14px 0 0"><svg class="icon icon-sm" style="vertical-align:-3px"><use href="#i-shield" /></svg> Thanh toán bảo mật qua VNPay</p>
            </aside>
        </div>
    }
</section>
