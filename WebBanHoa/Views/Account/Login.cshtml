@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-wrap">
    <div class="auth-art">
        <div class="petals"></div>
        <img src="/img/flowers/hero1.svg" alt="" />
        <blockquote>“Hoa là lời yêu thương không cần nói thành lời.”</blockquote>
    </div>
    <div class="auth-form">
        <div class="inner reveal">
            <span class="eyebrow">Chào mừng trở lại</span>
            <h1>Đăng nhập</h1>
            <p style="color:var(--ink-2)">Chưa có tài khoản? <a href="/tai-khoan/dang-ky" style="color:var(--rose);font-weight:600">Đăng ký ngay</a></p>
            <div class="demo-hint">Tài khoản demo: <b>khach@floria.vn</b> / <b>Khach@123</b></div>
            <form method="post" action="/tai-khoan/dang-nhap">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly"></div>
                <div class="field"><label asp-for="Email">Email</label><input class="input" asp-for="Email" placeholder="email@example.com" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                <div class="field"><label asp-for="Password">Mật khẩu</label><input class="input" asp-for="Password" placeholder="••••••••" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
                <label class="check" style="margin-bottom:22px"><input type="checkbox" asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
                <button class="btn btn-primary btn-block">Đăng nhập <svg class="icon icon-arrow"><use href="#i-arrow" /></svg></button>
            </form>
        </div>
    </div>
</section>
